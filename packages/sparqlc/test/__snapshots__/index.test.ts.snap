exports[`sparqlc query select runtime options applies distinct 1`] = `
"PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX fruit: <http://example.org/fruits/>
SELECT DISTINCT * WHERE {
  ?fruit <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> fruit:Fruit;
    rdfs:label ?label.
}"
`;

