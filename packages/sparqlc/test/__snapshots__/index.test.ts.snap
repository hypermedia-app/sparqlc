exports[`sparqlc query select runtime options applies modifiers to ask query 1`] = `
"PREFIX fruits: <http://example.org/fruits/>
ASK FROM NAMED <http://example.org/named-graph>
WHERE { ?s <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> fruits:Fruit. }"
`;

exports[`sparqlc query select runtime options applies modifiers to construct query 1`] = `
"PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
CONSTRUCT { ?fruit rdfs:label ?label. }
FROM <http://example.org/graph>
WHERE {
  VALUES ?_param_schema_mainEntity {
    <http://example.org/fruits/Banana>
  }
  BIND(IRI(?_param_schema_mainEntity) AS ?fruit)
  ?fruit rdfs:label ?label.
}
OFFSET 10
LIMIT 5"
`;

exports[`sparqlc query select runtime options applies order by array with tuples and strings 1`] = `
"PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX fruit: <http://example.org/fruits/>
SELECT * WHERE {
  ?fruit <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> fruit:Fruit;
    rdfs:label ?label.
}
ORDER BY DESC (?label) (?fruit)"
`;

