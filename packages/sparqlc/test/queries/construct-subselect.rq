PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX sparqlc: <https://sparqlc.described.at/>

CONSTRUCT {
    ?fruit rdfs:label ?label .
} WHERE {
    SELECT * {
      BIND (IRI(sparqlc:param(schema:mainEntity)) as ?fruit)

      ?fruit rdfs:label ?label .
    }
}
